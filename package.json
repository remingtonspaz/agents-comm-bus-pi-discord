{
  "name": "@agents-comm-bus/pi-discord",
  "version": "0.1.4",
  "description": "Pi host extension for agents-comm-bus — discord comm (bundles the shared pi-core).",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "node_modules/@agents-comm-bus/pi-core/extensions",
      "./extensions/discord"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@agents-comm-bus/pi-core": "git+https://github.com/remingtonspaz/agents-comm-bus-pi-core.git#5c452e070a01db2d2d1b1aba622b0a13bbadad85"
  },
  "bundledDependencies": [
    "@agents-comm-bus/pi-core"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node ./scripts/postinstall.mjs"
  },
  "license": "MIT"
}
